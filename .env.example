# Copy to .env and fill in. Names only here — never commit values.
# Where each one comes from and which phase needs it: docs/SETUP.md

# Phase 0
DATABASE_URL=

# Phase 1
DISCORD_WEBHOOK_URL=

# Phase 2
GEMINI_API_KEY=
GROQ_API_KEY=
SMTP_USER=
SMTP_APP_PASSWORD=

# Phase 3
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
ENCRYPTION_KEY=

# Phase 4
TAVILY_API_KEY=
SERPER_API_KEY=

# Public site address. The pipeline uses it for unsubscribe links in digests; the web uses it for redirects.
SITE_URL=

# Phase 5 (web; full list with comments in web/.env.example)
SESSION_SECRET=
ADMIN_EMAILS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Supabase Auth for email + password (web, and the daily keep-alive in GitHub). Anon key only, never service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google sign-in (web; set in Vercel). Redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ICS calendar feed token signing key (web). Generate: openssl rand -hex 32
CAL_FEED_SECRET=# 32+ random bytes hex; generate with: openssl rand -hex 32
